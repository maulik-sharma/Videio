# Copy to .env for local dev (docker compose reads it automatically).
# In production, set these as the Portainer stack's environment variables,
# with real secrets: generate each with `openssl rand -hex 32`.

# Postgres (core primary + replica)
POSTGRES_DB=videio
POSTGRES_USER=videio
POSTGRES_PASSWORD=change-me
# Password of the `replicator` role the replica streams WAL with
REPLICATION_PASSWORD=change-me-too

# Signs access-token JWTs; at least 32 characters
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789

# Object storage (SeaweedFS S3 gateway): the one identity the API and workers use
S3_ACCESS_KEY=videio-dev-access-key
S3_SECRET_KEY=change-me-s3-secret
# Host port of the S3 gateway (browsers upload to it; NPM forwards s3. here in prod)
S3_PORT=8333
# Production only: host address the S3 port binds to
S3_BIND=0.0.0.0

# Queue (RabbitMQ, taskiq's broker)
RABBITMQ_USER=videio
RABBITMQ_PASSWORD=change-me-rabbit
# Production only: where the management UI is published. Loopback by default;
# set RABBITMQ_UI_BIND to the VPS's Tailscale IP to reach it from the tailnet.
RABBITMQ_UI_BIND=127.0.0.1
RABBITMQ_UI_PORT=15672

# Edge: host port that serves the app (Nginx Proxy Manager forwards here in prod)
EDGE_PORT=8080
# Production only: host address the edge port binds to
EDGE_BIND=0.0.0.0

# Production only: image tag to run (CI's webhook call overrides this per deploy)
IMAGE_TAG=latest
