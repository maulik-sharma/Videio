# Copy to .env for local dev (docker compose reads it automatically).
# In production, set these as the Portainer stack's environment variables.

# Postgres (core primary)
POSTGRES_DB=videio
POSTGRES_USER=videio
POSTGRES_PASSWORD=change-me

# Edge: host port that serves the app (Nginx Proxy Manager forwards here in prod)
EDGE_PORT=8080
# Production only: host address the edge port binds to
EDGE_BIND=0.0.0.0

# Production only: image tag to run (CI's webhook call overrides this per deploy)
IMAGE_TAG=latest
